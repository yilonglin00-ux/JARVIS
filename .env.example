# JARVIS Host — Umgebungsvariablen
# Kopieren nach .env und ausfüllen. .env ist in .gitignore und darf NIE eingecheckt werden.
# Keys liegen ausschließlich auf dem Host. Der iPad-Client bekommt niemals einen Provider-Key.

# --- Zugang zum Core ---------------------------------------------------------
# Vorgeteilter Token, den der iPad-Client beim WS-Handshake mitschickt.
# Erzeugen z. B. mit:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_AUTH_TOKEN=

# Bind-Adresse des WS-Servers. 127.0.0.1 = nur lokal; im Tailscale-Netz 0.0.0.0.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# --- Provider-Keys -----------------------------------------------------------
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Optional, ab Phase 4
PERPLEXITY_API_KEY=
BRAVE_API_KEY=

# --- Verhalten ---------------------------------------------------------------
# debug | info | warning | error
JARVIS_LOG_LEVEL=info
# true schaltet Volltext-Transkripte ins Log (sonst redigiert). Nur zur Fehlersuche.
JARVIS_LOG_TRANSCRIPTS=false
